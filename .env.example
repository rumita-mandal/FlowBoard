# Copy to .env for local use:  node --env-file=.env server/index.js
PORT=3000
# REQUIRED in production. Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Where the SQLite file lives. Point at a persistent disk/volume in production.
DB_PATH=./data/taskflow.db
# Optional tuning
# AUTH_RATE_LIMIT=30     # login/register attempts per 15 min per IP
# GUEST_RATE_LIMIT=20    # demo sessions per hour per IP
# COOKIE_SECURE=false    # set only if you run NODE_ENV=production over plain http
